<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    桌宠界面的通用样式.

    这里只做 Windows 版 Panuon 那套控件的"观感对齐", 不追求逐像素一致:
    Panuon.WPF.UI 是个 WPF 专用的控件库, 跨平台版用的是 Avalonia 自带控件,
    硬追像素只会得到一堆难维护的模板. 对齐的是配色和圆角这类一眼能看出来的东西.

    所有颜色都走 DynamicResource: 换主题时资源字典整套被替换, 静态引用不会跟着变.
    -->

    <Style Selector="Window.vpet">
        <Setter Property="Background" Value="{DynamicResource SecondaryLighter}" />
        <Setter Property="FontFamily" Value="{DynamicResource VPetFont}" />
    </Style>

    <!--
    文字的默认颜色.
    SimpleTheme 给 TextBlock 的默认前景色很浅, 摆在浅色卡片上几乎看不清 ——
    渲染探针里那排格子就是这么发现的. 更具体的选择器(标题栏、说明文字)照样能盖过它.
    -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <!-- 标题栏 -->
    <Style Selector="Border.vpet-title">
        <Setter Property="Background" Value="{DynamicResource DARKPrimary}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.vpet-title TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DARKPrimaryText}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 主按钮 -->
    <Style Selector="Button.vpet">
        <Setter Property="Background" Value="{DynamicResource DARKPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource DARKPrimaryText}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.vpet:pointerover">
        <Setter Property="Background" Value="{DynamicResource DARKPrimaryLight}" />
    </Style>
    <Style Selector="Button.vpet:pressed">
        <Setter Property="Background" Value="{DynamicResource DARKPrimaryDarker}" />
    </Style>

    <!-- 次要按钮 -->
    <Style Selector="Button.vpet-secondary">
        <Setter Property="Background" Value="{DynamicResource Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.vpet-secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource SecondaryLight}" />
    </Style>

    <!-- 卡片 -->
    <Style Selector="Border.vpet-card">
        <Setter Property="Background" Value="{DynamicResource PrimaryTrans4}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- 正文 -->
    <Style Selector="TextBlock.vpet-body">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
    输入类控件.
    SimpleTheme 的默认输入框是深色底浅色字, 摆在这套浅色板里像挖了个洞 ——
    渲染探针一眼就能看出来. 这里把它拉回浅色.
    -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Secondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DARKPrimary}" />
    </Style>

    <!--
    滑块的轨道颜色没改: SimpleTheme 把它画在模板内部一个没有具名的元素上,
    要改就得整个替换模板. 深灰轨道在浅色板里稍重, 但看得清也用得了 ——
    为这点观感抄一整个模板, 将来 Avalonia 一升级就得跟着修, 不划算.
    (渲染探针的 setting 那页可以随时确认它现在长什么样)
    -->

    <!--
    勾选框.
    与 TextBlock 一个毛病: SimpleTheme 给的前景色太浅, 旁边那行字看不清.
    -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>

    <!--
    开关.
    SimpleTheme 默认在旁边写 On / Off, 界面是中文时很突兀; 开关的形状本身
    已经说明了状态, 把字去掉更干净.
    -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <!-- 进度条 -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource DARKPrimary}" />
        <Setter Property="Background" Value="{DynamicResource PrimaryTrans4}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="6" />
    </Style>

    <!-- 弱化的说明文字 -->
    <Style Selector="TextBlock.vpet-hint">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</Styles>
