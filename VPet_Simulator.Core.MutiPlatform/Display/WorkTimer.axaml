<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VPet_Simulator.Core.MutiPlatform.Display.WorkTimer"
             Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Top"
             Width="300" Height="180">
    <!--
    与 Windows 版 VPet-Simulator.Core/Display/WorkTimer.xaml 的布局和配色一致.
    这里的六个画刷是默认值, 真正显示时会被 Work.SetStyle 用 MOD 里配置的颜色整个换掉,
    所以必须用 DynamicResource 而不是写死的颜色.

    Windows 版这个类直接继承 Viewbox, 跨平台版改成 UserControl 内套一个 Viewbox:
    Avalonia 的 Viewbox 是密封的内容控件, 继承它没法用 x:Class 生成代码.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="WorkBorderBrush" Color="#FF0290D5" />
        <SolidColorBrush x:Key="WorkBackground" Color="#FF81d4fa" />
        <SolidColorBrush x:Key="WorkButtonBackground" Color="#AA0286C6" />
        <SolidColorBrush x:Key="WorkButtonBackgroundHover" Color="#FF0286C6" />
        <SolidColorBrush x:Key="WorkButtonForeground" Color="#FFffffff" />
        <SolidColorBrush x:Key="WorkForeground" Color="#FF0286C6" />
    </UserControl.Resources>
    <Viewbox>
        <Grid Width="300" Height="180">
            <Border x:Name="DisplayBorder" BorderThickness="4" CornerRadius="5"
                    Background="{DynamicResource WorkBackground}"
                    BorderBrush="{DynamicResource WorkBorderBrush}">
                <Grid ColumnDefinitions="2*,1*" RowDefinitions="2*,4*,1.5*">
                    <Viewbox Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Margin="45,0,5,0">
                        <TextBlock x:Name="tNow" Foreground="{DynamicResource WorkForeground}"
                                   FontSize="36" FontWeight="Bold" Text="当前已工作" />
                    </Viewbox>
                    <Viewbox Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="tNumber" Text="15.0" FontSize="80" FontWeight="Bold"
                                   Foreground="{DynamicResource WorkForeground}" />
                    </Viewbox>
                    <TextBlock x:Name="tNumberUnit" Grid.Row="1" Grid.Column="1" Text="分钟"
                               Foreground="{DynamicResource WorkForeground}" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,15" FontSize="36" />
                    <ProgressBar x:Name="PBLeft" Grid.Row="2" Grid.ColumnSpan="2" Background="Transparent"
                                 Foreground="{DynamicResource WorkButtonBackgroundHover}" Value="20" />
                    <Button x:Name="btnStop" Grid.Row="2" Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Foreground="{DynamicResource WorkButtonForeground}"
                            Background="{DynamicResource WorkButtonBackground}"
                            Content="停止工作" FontSize="24" Click="btnStop_Click" />
                </Grid>
            </Border>
            <Button x:Name="btnSwitch" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,5,8,7"
                    Background="{DynamicResource WorkBorderBrush}" CornerRadius="5" Margin="10,10,0,0"
                    Click="SwitchState_Click">
                <Path Fill="{DynamicResource WorkButtonForeground}"
                      Data="M3 2.9918C3 2.44405 3.44495 2 3.9934 2H20.0066C20.5552 2 21 2.45531 21 2.9918V21.0082C21 21.556 20.5551 22 20.0066 22H3.9934C3.44476 22 3 21.5447 3 21.0082V2.9918ZM19 11V4H5V11H19ZM19 13H5V20H19V13ZM9 6H15V8H9V6ZM9 15H15V17H9V15Z" />
            </Button>
        </Grid>
    </Viewbox>
</UserControl>
