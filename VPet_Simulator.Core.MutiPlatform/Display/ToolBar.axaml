<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VPet_Simulator.Core.MutiPlatform.Controls.ToolBar">
  <Border Background="#AA101010" CornerRadius="8" Padding="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="WorkButton" Content="Work"/>
      <Button x:Name="StudyButton" Content="Study"/>
      <Button x:Name="PlayButton" Content="Play"/>
      <Button x:Name="PanelButton" Content="Panel"/>
    </StackPanel>
  </Border>
</UserControl>
