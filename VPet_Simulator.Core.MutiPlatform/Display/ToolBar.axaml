<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
             x:Class="VPet_Simulator.Core.MutiPlatform.Display.ToolBar"
             Width="500" Height="500" VerticalAlignment="Top"
             PointerEntered="UserControl_MouseEnter" PointerExited="UserControl_MouseLeave">
    <!--
    与 Windows 版 VPet-Simulator.Core/Display/ToolBar.xaml 对应: 底部一排菜单,
    悬停"面板"时在菜单上方弹出数值面板.

    Windows 版的菜单外观来自 Panuon.WPF.UI, 那套控件库是 WPF 独占的, 跨平台版只能
    照着它的观感用 Avalonia 的 Style 重写一遍 —— 深蓝底、白字、居中、悬停变亮.
    -->
    <UserControl.Resources>
        <!--
        进度条的斜纹画刷, 照搬 basestyle.xaml 里的 DrawingBrush:
        8×22 的贴片, 左边 5.5 实色 + 右边 2.5 半透明.
        Windows 版还整体旋转了 2 度, Avalonia 的画刷没有 RelativeTransform,
        这点纯装饰的差异就不还原了.
        -->
        <DrawingBrush x:Key="ProgressBarForeground" TileMode="Tile" Stretch="None"
                      SourceRect="0,0,8,22" DestinationRect="0,0,8,22">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#AA039be5" Geometry="M5.5,0 L8,0 L8,22 L5.5,22 Z" />
                    <GeometryDrawing Brush="#FF039be5" Geometry="M0,0 L5.5,0 L5.5,22 L0,22 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="SuccessProgressBarForeground" TileMode="Tile" Stretch="None"
                      SourceRect="0,0,8,22" DestinationRect="0,0,8,22">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#AAAACC6C" Geometry="M5.5,0 L8,0 L8,22 L5.5,22 Z" />
                    <GeometryDrawing Brush="#FFAACC6C" Geometry="M0,0 L5.5,0 L5.5,22 L0,22 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="WarningProgressBarForeground" TileMode="Tile" Stretch="None"
                      SourceRect="0,0,8,22" DestinationRect="0,0,8,22">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#AAFFCC4C" Geometry="M5.5,0 L8,0 L8,22 L5.5,22 Z" />
                    <GeometryDrawing Brush="#FFFFCC4C" Geometry="M0,0 L5.5,0 L5.5,22 L0,22 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="DangerProgressBarForeground" TileMode="Tile" Stretch="None"
                      SourceRect="0,0,8,22" DestinationRect="0,0,8,22">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#AAFF4C4C" Geometry="M5.5,0 L8,0 L8,22 L5.5,22 Z" />
                    <GeometryDrawing Brush="#FFFF4C4C" Geometry="M0,0 L5.5,0 L5.5,22 L0,22 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Menu#ToolBarMenu">
            <Setter Property="Background" Value="{DynamicResource DARKPrimary}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Menu#ToolBarMenu > MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource DARKPrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- Avalonia 的 MenuItem 没有 ContentAlignment, 只能直接摆模板里的 Header -->
        <Style Selector="Menu#ToolBarMenu > MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Menu#ToolBarMenu > MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource DARKPrimaryDarker}" />
        </Style>
        <!-- 二级菜单是弹出层, 底色要给足, 否则会透出桌面 -->
        <Style Selector="MenuItem MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource DARKPrimary}" />
            <Setter Property="Background" Value="{DynamicResource DARKPrimaryText}" />
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="MenuItem MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SecondaryLighter}" />
        </Style>
        <Style Selector="Border#BdrPanel TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border#BdrPanel TextBlock.barText">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource DARKPrimaryText}" />
        </Style>
        <Style Selector="Border#BdrPanel ProgressBar">
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource ProgressBarForeground}" />
        </Style>
    </UserControl.Styles>

    <!-- 公开给宿主: 选项式聊天框挂在这里, 与 Windows 版 MainGrid 的用法一致 -->
    <Grid x:Name="MainGrid" x:FieldModifier="public">
        <Border x:Name="BdrPanel" x:FieldModifier="public" Margin="0,0,0,55" VerticalAlignment="Bottom" IsVisible="False"
                Background="{DynamicResource DARKPrimaryText}"
                BorderBrush="{DynamicResource DARKPrimaryDarker}" BorderThickness="1" CornerRadius="5"
                PointerExited="MenuPanel_MouseLeave">
            <Grid x:Name="gdPanel" x:FieldModifier="public" Margin="15"
                  ColumnDefinitions="Auto,5,*,5,Auto"
                  RowDefinitions="30,Auto,30,30,30,30,30,30">
                <TextBlock x:Name="Tlv" x:FieldModifier="public" Grid.ColumnSpan="3" Foreground="{DynamicResource DARKPrimary}" Text="Lv 14" />
                <!-- 详细: 打开角色面板. Windows 版是个下划线文字按钮 -->
                <Button Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Padding="0" Click="MenuPanel_Click" Cursor="Hand"
                        Foreground="{DynamicResource DARKPrimary}" Grid.Row="2">
                    <TextBlock Text="{ll:Str 详细}" TextDecorations="Underline" FontSize="24" />
                </Button>
                <TextBlock x:Name="till" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="5" Foreground="#FF4C4C"
                           Text="{ll:Str 宠物已经生病\, 通过服用药物可以恢复}" ToolTip.Tip="{ll:Str 宠物已经生病\, 通过服用药物可以恢复}" TextWrapping="Wrap" IsVisible="False" />
                <TextBlock x:Name="tfun" x:FieldModifier="public" Grid.Row="1" Grid.ColumnSpan="5" Foreground="#4caf50"
                           Text="{ll:Str 已关闭数据计算\, 可放心挂机}" ToolTip.Tip="{ll:Str 已关闭数据计算\, 可放心挂机}" TextWrapping="Wrap" IsVisible="False" />

                <TextBlock Grid.Row="2" Text="{ll:Str 金钱}" />
                <TextBlock x:Name="tMoney" Grid.Row="2" Grid.Column="2"
                           Foreground="{DynamicResource DARKPrimary}" Text="$100,000" />

                <TextBlock Grid.Row="3" Text="{ll:Str 经验}" />
                <ProgressBar x:Name="pExp" Grid.Row="3" Grid.Column="2" Value="40" />
                <TextBlock x:Name="tExpValue" Grid.Row="3" Grid.Column="2" Classes="barText" />
                <TextBlock x:Name="tExp" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Right"
                           Foreground="{DynamicResource DARKPrimary}" Text="x1.0" />

                <TextBlock Grid.Row="4" Text="{ll:Str 体力}" />
                <ProgressBar x:Name="pStrength" Grid.Row="4" Grid.Column="2" Maximum="100" Value="40" />
                <TextBlock x:Name="tStrengthValue" Grid.Row="4" Grid.Column="2" Classes="barText" />
                <TextBlock x:Name="tStrength" Grid.Row="4" Grid.Column="4" HorizontalAlignment="Right"
                           Foreground="{DynamicResource DARKPrimary}" Text="+1/t" />

                <TextBlock Grid.Row="5" Text="{ll:Str 心情}" />
                <ProgressBar x:Name="pFeeling" Grid.Row="5" Grid.Column="2" Maximum="100" Value="60" />
                <TextBlock x:Name="tFeelingValue" Grid.Row="5" Grid.Column="2" Classes="barText" />
                <TextBlock x:Name="tFeeling" Grid.Row="5" Grid.Column="4" HorizontalAlignment="Right"
                           Foreground="{DynamicResource DARKPrimary}" Text="+1/t" />

                <!-- Max 那条画的是"算上存储值之后能涨到多少", 半透明垫在实际值下面 -->
                <TextBlock Grid.Row="6" Text="{ll:Str 饱腹度}" />
                <ProgressBar x:Name="pStrengthFoodMax" Grid.Row="6" Grid.Column="2" Background="#FFDDDDDD"
                             Maximum="100" Opacity="0.5" Value="90" />
                <ProgressBar x:Name="pStrengthFood" Grid.Row="6" Grid.Column="2" Background="Transparent"
                             Maximum="100" Value="60" />
                <TextBlock x:Name="tStrengthFoodValue" Grid.Row="6" Grid.Column="2" Classes="barText" />
                <TextBlock x:Name="tStrengthFood" Grid.Row="6" Grid.Column="4" HorizontalAlignment="Right"
                           Foreground="{DynamicResource DARKPrimary}" Text="+1/t" />

                <TextBlock Grid.Row="7" Text="{ll:Str 口渴度}" />
                <ProgressBar x:Name="pStrengthDrinkMax" Grid.Row="7" Grid.Column="2" Background="#FFDDDDDD"
                             Maximum="100" Opacity="0.5" Value="90" />
                <ProgressBar x:Name="pStrengthDrink" Grid.Row="7" Grid.Column="2" Background="Transparent"
                             Maximum="100" Value="60" />
                <TextBlock x:Name="tStrengthDrinkValue" Grid.Row="7" Grid.Column="2" Classes="barText" />
                <TextBlock x:Name="tStrengthDrink" Grid.Row="7" Grid.Column="4" HorizontalAlignment="Right"
                           Foreground="{DynamicResource DARKPrimary}" Text="+1/t" />
            </Grid>
        </Border>

        <Menu x:Name="ToolBarMenu" Width="500" Height="60" VerticalAlignment="Bottom">
            <!--
            Windows 版把列数存在 Menu.Tag 里, 显示/隐藏"自定"时手动改成 4 或 5.
            Avalonia 的 UniformGrid 只写 Rows=1 就会按可见子项自动分列, 不用再手动维护.
            -->
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem x:Name="MenuFeed" x:FieldModifier="public" Header="{ll:Str 投喂}" />
            <MenuItem x:Name="MenuPanel" Header="{ll:Str 面板}"
                      PointerEntered="MenuPanel_MouseEnter" PointerExited="MenuPanel_MouseLeave" />
            <MenuItem x:Name="MenuInteract" x:FieldModifier="public" Header="{ll:Str 互动}">
                <MenuItem x:Name="MenuSleep" Header="{ll:Str 睡觉}" Click="Sleep_Click" />
                <MenuItem x:Name="MenuStudy" x:FieldModifier="public" Header="{ll:Str 学习}" />
                <MenuItem x:Name="MenuPlay" x:FieldModifier="public" Header="{ll:Str 玩耍}" />
                <MenuItem x:Name="MenuWork" x:FieldModifier="public" Header="{ll:Str 工作}" />
            </MenuItem>
            <MenuItem x:Name="MenuDIY" x:FieldModifier="public" Header="{ll:Str 自定}" IsVisible="False" />
            <MenuItem x:Name="MenuSetting" x:FieldModifier="public" Header="{ll:Str 系统}">
                <MenuItem x:Name="MenuMODConfig" x:FieldModifier="public" Header="{ll:Str MOD设置}" IsVisible="False" />
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
