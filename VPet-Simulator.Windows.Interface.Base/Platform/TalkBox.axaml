<!-- 跨平台: 原文复制自 VPet-Simulator.Windows.Interface/TalkBox.xaml; Height=Auto 是 WPF 默认值, InputMethod 附加属性没有对应物 -->
<UserControl x:Class="VPet_Simulator.Windows.Interface.TalkBox"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
        xmlns:shell="using:VPet_Simulator.Core.MutiPlatform.Display.Shell" Height="500" Width="500" VerticalAlignment="Top">
    <Border Background="{DynamicResource PrimaryLighter}" BorderBrush="{DynamicResource Primary}" BorderThickness="5"
            VerticalAlignment="Top" Margin="5" CornerRadius="5" Padding="5,5,5,3">
        <Grid x:Name="MainGrid" x:FieldModifier="public">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:FieldModifier="public" x:Name="tbTalk" Theme="{DynamicResource StandardTextBoxStyle}"
                    Watermark="{ll:Str 和桌宠说}" FontSize="30" AcceptsReturn="True"
                    TextWrapping="WrapWithOverflow"
                    />
            <Button x:Name="btnSend" CornerRadius="4" Content="{ll:Str '发送'}" BorderThickness="2"
                    Background="{DynamicResource SecondaryLight}" Grid.Column="2"
                    BorderBrush="{DynamicResource DARKPrimaryDarker}" FontSize="30" ToolTip.Tip="{ll:Str '按 Ctrl+Enter 发送'}"
                    Click="Send_Click" x:FieldModifier="public" />
            <Grid x:Name="PublicGrid" Grid.Row="2" Grid.ColumnSpan="3" x:FieldModifier="public" />
        </Grid>
    </Border>
</UserControl>
