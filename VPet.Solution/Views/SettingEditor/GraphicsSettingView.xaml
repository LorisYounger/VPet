<UserControl x:Class="VPet.Solution.Views.SettingEditor.GraphicsSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
             xmlns:local="clr-namespace:VPet.Solution.Views.SettingEditor"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pu="https://opensource.panuon.com/wpf-ui"
             xmlns:vm="clr-namespace:VPet.Solution.ViewModels.SettingEditor"
             xmlns:m="clr-namespace:VPet.Solution.Models.SettingEditor"
             d:DataContext="{d:DesignInstance Type=vm:GraphicsSettingViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="800"
             mc:Ignorable="d"
             d:Background="White">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel>
                    <Border Height="50"
                            Style="{StaticResource Border_SettingItem}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Style="{DynamicResource TextBlock_SettingName}"
                                       Text="{ll:Str 语言}" />
                            <ComboBox x:Name="Languages"
                                      MinWidth="200"
                                      Grid.Column="1"
                                      Style="{DynamicResource ComboBox_BaseStyle}"
                                      ItemsSource="{Binding Source={x:Static m:GraphicsSettingModel.Languages}}"
                                      SelectedItem="{Binding GraphicsSetting.Language}" />
                        </Grid>
                    </Border>
                    <Border Height="50"
                            Style="{StaticResource Border_SettingItem}">
                        <Grid ColumnDefinitions="*,Auto"
                              Height="40">
                            <TextBlock Text="{ll:Str 字体}"
                                       Style="{DynamicResource TextBlock_SettingName}" />
                            <ComboBox x:Name="Fonts"
                                      Grid.Column="1"
                                      MinWidth="200"
                                      Style="{DynamicResource ComboBox_BaseStyle}"
                                      ItemsSource="{Binding Source={x:Static m:GraphicsSettingModel.Fonts}}"
                                      SelectedItem="{Binding GraphicsSetting.Font}" />
                        </Grid>
                    </Border>
                    <Border Height="50"
                            Style="{StaticResource Border_SettingItem}">
                        <Grid ToolTip="{ll:Str 将消息框置于外部}"
                              ColumnDefinitions="*,Auto">
                            <TextBlock Text="{ll:Str 外部消息框}"
                                       Style="{DynamicResource TextBlock_SettingName}" />
                            <pu:Switch x:Name="MessageBarOutside"
                                       Grid.Column="1"
                                       Style="{DynamicResource Switch_SwitchOnly}"
                                       IsChecked="{Binding GraphicsSetting.MessageBarOutside}" />
                        </Grid>
                    </Border>

                    <Border Height="50"
                            Style="{StaticResource Border_SettingItem}">
                        <Grid ColumnDefinitions="*,Auto"
                              Height="40"
                              ToolTip="{ll:Str '在任务切换器中和Alt+Tab中隐藏窗口'}">
                            <TextBlock Text="{ll:Str 隐藏窗口}"
                                       Style="{DynamicResource TextBlock_SettingName}" />
                            <pu:Switch x:Name="HideFromTaskControl"
                                       Grid.Column="1"
                                       Style="{DynamicResource Switch_SwitchOnly}"
                                       IsChecked="{Binding GraphicsSetting.HideFromTaskControl}" />
                        </Grid>
                    </Border>
                </StackPanel>
                <GroupBox Margin="0,5,0,0"
                          Style="{StaticResource GroupBox_SettingGroup}"
                          Header="{ll:Str '置于顶层'}">
                    <StackPanel>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '将桌宠置于顶层'}">
                                <TextBlock Text="{ll:Str '将桌宠置于顶层'}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="TopMost"
                                           Grid.Column="1"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.TopMost}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '鼠标将会穿过桌宠到下方内容,不打扰操作\&#13;该选项'}">
                                <TextBlock Text="{ll:Str '鼠标穿透'}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="HitThrough"
                                           Grid.Column="1"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.HitThrough}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '添加快速切换小标,切换顶层或穿透'}">
                                <TextBlock Text="{ll:Str '快速切换'}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="PetHelper"
                                           Grid.Column="1"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.PetHelper}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>
                <GroupBox Margin="0,5,0,0"
                          Style="{StaticResource GroupBox_SettingGroup}"
                          Header="{ll:Str '缩放'}">
                    <StackPanel>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid Height="40"
                                  ColumnDefinitions="*,Auto"
                                  ToolTip="{ll:Str '解锁缩放限制,支持更大缩放倍率'}">
                                <TextBlock Text="{ll:Str 更高缩放}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="IsBiggerScreen"
                                           Grid.Column="1"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.IsBiggerScreen}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40">
                                <TextBlock Text="{ll:Str 缩放等级}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:NumberInput Grid.Column="1"
                                                Width="100"
                                                x:Name="ZoomLevel"
                                                Foreground="{DynamicResource DARKPrimaryDarker}"
                                                Interval="0.1"
                                                Style="{DynamicResource NumberInput_BaseStyle}"
                                                Value="{Binding GraphicsSetting.ZoomLevel}"
                                                Maximum="{Binding GraphicsSetting.ZoomLevelMaximum}"
                                                Minimum="{Binding GraphicsSetting.ZoomLevelMinimum}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '桌宠图形渲染的分辨率,越高图形越清晰\&#13;但是高分辨率会占用更多内存\&#13;重启后生效'}">
                                <TextBlock Text="{ll:Str 渲染分辨率}"
                                           Style="{DynamicResource  TextBlock_SettingName}" />
                                <pu:NumberInput Grid.Column="1"
                                                Interval="10"
                                                Width="100"
                                                x:Name="Resolution"
                                                Style="{DynamicResource NumberInput_BaseStyle}"
                                                Value="{Binding GraphicsSetting.Resolution}"
                                                Maximum="{Binding GraphicsSetting.ResolutionMaximum}"
                                                Minimum="{Binding GraphicsSetting.ResolutionMinimum}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>
                <GroupBox Margin="0,5,0,0"
                          Style="{StaticResource GroupBox_SettingGroup}"
                          Header="{ll:Str '启动'}">
                    <StackPanel>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{ll:Str 启动位置}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,Auto,Auto,Auto"
                                      Grid.Column="1">
                                    <Label Grid.Column="0"
                                           Content="X"
                                           Style="{DynamicResource Label_BaseStyle}" />
                                    <pu:NumberInput Grid.Column="1"
                                                    Width="100"
                                                    x:Name="StartRecordPointX"
                                                    Style="{DynamicResource NumberInput_BaseStyle}"
                                                    Value="{Binding GraphicsSetting.StartRecordPoint.X}" />
                                    <Label Grid.Column="2"
                                           Content="Y"
                                           Style="{DynamicResource Label_BaseStyle}" />
                                    <pu:NumberInput Grid.Column="3"
                                                    x:Name="StartRecordPointY"
                                                    Width="100"
                                                    Style="{DynamicResource NumberInput_BaseStyle}"
                                                    Value="{Binding GraphicsSetting.StartRecordPoint.Y}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str 设为当前窗口左上角顶点坐标的位置}">
                                <TextBlock Text="{ll:Str 设为当前位置}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <Button x:Name="SetCurrentPointToStartPoint"
                                        Grid.Column="1"
                                        MinWidth="100"
                                        Click="SetCurrentPointToStartPoint_Click"
                                        Content="{ll:Str 设定}"
                                        Style="{DynamicResource Button_BaseStyle}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40">
                                <TextBlock Text="{ll:Str 保存为退出位置}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="StartRecordLast"
                                           Grid.Column="1"
                                           Style="{DynamicResource  Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.StartRecordLast}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '该游戏随着开机启动该程序\&#13;如需卸载游戏\&#13;请关闭该选项'}">
                                <TextBlock Text="{ll:Str 开机启动}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="StartUPBoot"
                                           Grid.Column="1"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.StartUPBoot}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  ToolTip="{ll:Str '从Steam启动该游戏, 统计时长不能停'}">
                                <TextBlock Text="{ll:Str 从Steam启动}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="StartUPBootSteam"
                                           Grid.Column="2"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.StartUPBootSteam}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>
                <!-- TODO: 翻译暂未实现 -->
                <GroupBox Margin="0,5,0,0"
                          Style="{StaticResource GroupBox_SettingGroup}"
                          Header="{ll:Str '主题与动画'}">
                    <StackPanel>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '设置主题'}">
                                <TextBlock Text="{ll:Str 主题}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <ComboBox x:Name="Theme"
                                          Grid.Column="1"
                                          MinWidth="200"
                                          Style="{DynamicResource ComboBox_BaseStyle}"
                                          ItemsSource="{Binding Source={x:Static m:GraphicsSettingModel.Themes}}"
                                          SelectedItem="{Binding GraphicsSetting.Theme}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '桌宠动画'}">
                                <TextBlock Text="{ll:Str 桌宠动画}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <ComboBox x:Name="Pet"
                                          Grid.Column="1"
                                          MinWidth="200"
                                          Style="{DynamicResource ComboBox_BaseStyle}"
                                          ItemsSource="{Binding Source={x:Static m:GraphicsSettingModel.PetGraphs}}"
                                          SelectedItem="{Binding GraphicsSetting.PetGraph}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '桌宠透明度'}">
                                <TextBlock Text="{ll:Str 透明度}"
                                           Style="{DynamicResource  TextBlock_SettingName}" />
                                <pu:NumberInput Grid.Column="1"
                                                Interval="0.05"
                                                Width="100"
                                                x:Name="Opacity"
                                                Style="{DynamicResource NumberInput_BaseStyle}"
                                                Value="{Binding GraphicsSetting.Opacity}"
                                                Maximum="1"
                                                Minimum="0.05" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '常态透明度'}">
                                <TextBlock Text="{ll:Str '常态透明度'}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="OpacityMain"
                                           Grid.Column="1"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.OpacityMain}" />
                            </Grid>
                        </Border>
                        <Border Height="50"
                                Style="{StaticResource Border_SettingGroupItem}">
                            <Grid ColumnDefinitions="*,Auto"
                                  Height="40"
                                  ToolTip="{ll:Str '鼠标穿透透明度'}">
                                <TextBlock Text="{ll:Str '鼠标穿透透明度'}"
                                           Style="{DynamicResource TextBlock_SettingName}" />
                                <pu:Switch x:Name="OpacityHitThrough"
                                           Grid.Column="1"
                                           Style="{DynamicResource Switch_SwitchOnly}"
                                           IsChecked="{Binding GraphicsSetting.OpacityHitThrough}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
