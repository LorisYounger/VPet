<UserControl
  x:Class="VPet.Solution.Views.SettingEditor.DiagnosticSettingView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.Solution.Views.SettingEditor"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.Solution.ViewModels.SettingEditor"
  xmlns:m="clr-namespace:VPet.Solution.Models.SettingEditor"
  d:DataContext="{d:DesignInstance Type=vm:DiagnosticSettingViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
  d:Background="White"
>
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox
          Header="{ll:Str 自动超模MOD优化}"
          Margin="0,5,0,0"
          Style="{DynamicResource GroupBox_SettingGroup}"
        >
          <StackPanel>
            <Border Height="100" Style="{StaticResource Border_SettingGroupItem}">
              <Grid RowDefinitions="*,*">
                <TextBlock
                  VerticalAlignment="Center"
                  Text="{ll:Str '对于超模内容,游戏会自动计算合理价格.\&#13;如果未使用任何超模数据,数据菜单栏将会显示图标方便您进行炫耀数据.'}"
                />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                  <TextBlock
                    Style="{DynamicResource TextBlock_SettingName}"
                    Text="{ll:Str '自动计算合理价格'}"
                  />
                  <pu:Switch
                    x:Name="AutoCal"
                    Grid.Column="1"
                    IsChecked="{Binding DiagnosticSetting.AutoCal}"
                    Style="{DynamicResource Switch_SwitchOnly}"
                  />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
        </GroupBox>
        <GroupBox
          Header="{ll:Str 诊断与反馈}"
          Margin="0,5,0,0"
          Style="{DynamicResource GroupBox_SettingGroup}"
        >
          <StackPanel>
            <Border Height="100" Style="{StaticResource Border_SettingGroupItem}">
              <Grid RowDefinitions="*,*">
                <TextBlock
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{x:Null}"
                  FontSize="13"
                  TextWrapping="Wrap"
                >
                  <Run Text="{ll:Str '选择要发送给 LBGame 的诊断数据,诊断数据用于保护和及时更新 虚拟桌宠模拟器, 解决问题并改进产品.'}" />
                  <LineBreak />
                  <Run Text="{ll:Str '无论选择哪个选项,游戏都可以安全正常地运行.'}" />
                  <Hyperlink Command="{Binding hyper_moreInfoCommand}">
                    <Run Text="{ll:Str 获取有关这些设置的更多信息}" />
                  </Hyperlink>
                  <LineBreak />
                  <Run FontWeight="Bold" Text="{ll:Str '当前存档Hash验证信息'}" />
                  <Run FontWeight="Bold" Text=":" />
                  <Run x:Name="HashCheckState" FontWeight="Bold" Text="通过" />
                </TextBlock>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                  <TextBlock
                    Visibility="{Binding IsChecked,ElementName=Diagnosis,Converter={StaticResource FalseToHiddenConverter}}"
                    Style="{DynamicResource TextBlock_SettingName}"
                    Text="{ll:Str '发送诊断数据:\&#13;发送游戏存档, 包括饱腹,状态等各种游戏内数据. 可能会包括该游戏内存和CPU使用情况'}"
                  />
                  <TextBlock
                    Visibility="{Binding IsChecked,ElementName=Diagnosis,Converter={StaticResource FalseToVisibleConverter}}"
                    Style="{DynamicResource TextBlock_SettingName}"
                    Text="{ll:Str '不发送诊断数据:\&#13;适用于启用修改器,修改过游戏数据等不符合分析数据条件. 或不希望提供游戏数据的玩家'}"
                  />
                  <pu:Switch
                    Grid.Column="1"
                    x:Name="Diagnosis"
                    IsChecked="{Binding DiagnosticSetting.Diagnosis}"
                    Style="{DynamicResource Switch_SwitchOnly}"
                  />
                </Grid>
              </Grid>
            </Border>
            <Border Height="50" Style="{StaticResource Border_SettingGroupItem}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                  Text="{ll:Str '反馈频率(每周期)'}"
                  Style="{DynamicResource TextBlock_SettingName}"
                />
                <ComboBox
                  ItemsSource="{Binding Source={x:Static m:DiagnosticSettingModel.DiagnosisIntervals}}"
                  Grid.Column="1"
                  x:Name="DiagnosisIntervals"
                  SelectedItem="{Binding DiagnosticSetting.DiagnosisInterval}"
                  Width="200"
                  Style="{DynamicResource ComboBox_BaseStyle}"
                />
              </Grid>
            </Border>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
