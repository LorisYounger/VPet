<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels"
  x:Class="VPet.Solution.MultiPlatform.Views.MainWindow"
  x:DataType="vm:MainViewModel"
  Title="{ll:Str 'VPET 问题解决工具'}"
  Icon="/Assets/icon.ico"
  Width="400"
  Height="450"
  MinWidth="400"
  MinHeight="200"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*">
    <Label MinHeight="200" Content="{ll:Str 'VPET 问题解决工具'}" FontSize="32" Classes="Base" />
    <ComboBox
      x:Name="Languages"
      MinWidth="150"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      ItemsSource="{Binding AvailableCultures}"
      SelectedItem="{Binding CurrentCulture}"
      Classes="Base"
    >
      <ComboBox.ContextMenu>
        <ContextMenu>
          <MenuItem
            x:Name="OpenLocalText"
            Header="{ll:Str 打开翻译文本}"
            Command="{Binding OpenLocalTextCommand}"
          />
        </ContextMenu>
      </ComboBox.ContextMenu>
    </ComboBox>
    <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto">
      <StackPanel>
        <Button
          x:Name="OpenSettingEditor"
          MinWidth="150"
          Content="{ll:Str 打开设置编辑器}"
          FontSize="16"
          Command="{Binding OpenSettingEditorCommand}"
          Classes="Base"
        />
        <Button
          x:Name="OpenSaveViewer"
          MinWidth="150"
          Content="{ll:Str 打开存档查看器}"
          Command="{Binding OpenSaveViewerCommand}"
          FontSize="16"
          Classes="Base"
        />
      </StackPanel>
      <Button
        x:Name="WantOpenVpet"
        Grid.Row="1"
        Height="30"
        Command="{Binding WantOpenVpetCommand}"
        Classes="Link"
        Content="{ll:Str '想打开桌宠本体?'}"
        FontSize="16"
      />
      <Button
        x:Name="FirstStartFailed"
        Grid.Row="2"
        Height="30"
        Command="{Binding FirstStartFailedCommand}"
        Classes="Link"
        Content="{ll:Str '第一次启动桌宠打不开?'}"
        FontSize="16"
      />
    </Grid>
  </Grid>
</Window>
