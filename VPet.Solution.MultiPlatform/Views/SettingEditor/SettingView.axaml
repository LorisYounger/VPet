<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:local="using:VPet.Solution.MultiPlatform"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels"
  xmlns:m="using:VPet.Solution.MultiPlatform.Models"
  xmlns:v="using:VPet.Solution.MultiPlatform.Views"
  mc:Ignorable="d"
  d:DesignWidth="1000"
  d:DesignHeight="640"
  x:Class="VPet.Solution.MultiPlatform.Views.SettingView"
  x:DataType="vm:SettingViewModel"
>
  <Design.DataContext>
    <vm:SettingViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Grid#RootGrid.expanded SplitView#MainSplitView">
      <Setter Property="DisplayMode" Value="Inline" />
      <Setter Property="IsPaneOpen" Value="True" />
    </Style>
    <Style Selector="Grid#RootGrid.compact SplitView#MainSplitView">
      <Setter Property="DisplayMode" Value="Overlay" />
    </Style>
    <Style Selector="Grid#RootGrid.expanded Button#TogglePaneButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#RootGrid.compact Button#TogglePaneButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid
    x:Name="RootGrid"
    local:ResponsiveHelper.Enable="True"
    local:ResponsiveHelper.Breakpoint="720"
    RowDefinitions="Auto,*"
  >
    <!-- 顶部应用栏 -->
    <Border Grid.Row="0" Classes="ToolbarHeader">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button
            IsVisible="{Binding IsSingleView}"
            Classes="IconAction"
            Command="{Binding NavigateBackCommand}"
            ToolTip.Tip="{ll:Str 返回}"
          >
            <ui:FASymbolIcon Symbol="Back" FontSize="16" />
          </Button>
          <Button
            x:Name="TogglePaneButton"
            Classes="IconAction"
            Click="TogglePaneButton_Click"
            ToolTip.Tip="{ll:Str 设置文件}"
          >
            <ui:FASymbolIcon Symbol="GlobalNavigationButton" FontSize="16" />
          </Button>
          <TextBlock
            Text="{Binding CurrentSetting.Name, FallbackValue=''}"
            FontSize="15"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
          />
          <ui:FAInfoBadge
            IsVisible="{Binding CurrentSetting.IsChanged, FallbackValue=False}"
            VerticalAlignment="Center"
            ToolTip.Tip="{ll:Str 未保存}"
          />
        </StackPanel>

        <Button
          Grid.Column="1"
          IsEnabled="{Binding CurrentSetting, Converter={StaticResource NullToFalseConverter}}"
          Classes.accent="{Binding CurrentSetting.IsChanged, FallbackValue=False}"
          Command="{Binding SaveSettingCommand}"
          CommandParameter="{Binding CurrentSetting}"
        >
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:FASymbolIcon Symbol="Save" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="{ll:Str 保存}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- 主体抽屉主从布局 -->
    <SplitView
      x:Name="MainSplitView"
      Grid.Row="1"
      OpenPaneLength="240"
      CompactPaneLength="0"
      PaneBackground="{DynamicResource LayerFillColorDefaultBrush}"
    >
      <SplitView.Pane>
        <Grid
          IsEnabled="{Binding Settings.SourceList.Count,Converter={StaticResource Int32CompareByConverter},ConverterParameter='>0'}"
          Margin="10"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="5"
        >
          <TextBlock
            Grid.Row="0"
            Text="{ll:Str 存档文件}"
            FontWeight="Bold"
            Classes="SectionHeader"
            Margin="0"
          />
          <TextBox
            Grid.Row="1"
            x:Name="SearchSetting"
            PlaceholderText="{ll:Str 搜索文件}"
            Text="{Binding SearchSetting}"
          >
            <TextBox.InnerLeftContent>
              <ui:FASymbolIcon
                Symbol="Find"
                FontSize="14"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
              />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ListBox
            x:Name="Settings"
            Grid.Row="2"
            ItemsSource="{Binding Settings.FilteredList}"
            SelectedItem="{Binding CurrentSetting}"
            SelectionChanged="Settings_SelectionChanged"
          >
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem
                  Header="{ll:Str 打开文件}"
                  Command="{Binding OpenFileCommand}"
                  CommandParameter="{Binding CurrentSetting}"
                />
                <MenuItem
                  Header="{ll:Str 从资源管理器打开文件}"
                  Command="{Binding OpenFileFromExplorerCommand}"
                  CommandParameter="{Binding CurrentSetting}"
                />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:SettingModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding FilePath}">
                  <TextBlock
                    Grid.Column="0"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                  />
                  <ui:FAInfoBadge
                    Grid.Column="1"
                    IsVisible="{Binding IsChanged}"
                    VerticalAlignment="Center"
                  />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 底部操作组 2x2 网格 -->
          <UniformGrid Grid.Row="3" Columns="2" Margin="0,4,0,0">
            <Button
              Margin="2"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              IsEnabled="{Binding CurrentSetting, Converter={StaticResource NullToFalseConverter}}"
              x:Name="SaveSetting"
              Content="{ll:Str 保存}"
              Classes.accent="{Binding CurrentSetting.IsChanged, FallbackValue=False}"
              Command="{Binding SaveSettingCommand}"
              CommandParameter="{Binding CurrentSetting}"
            />
            <Button
              Margin="2"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              IsEnabled="{Binding CurrentSetting, Converter={StaticResource NullToFalseConverter}}"
              x:Name="ResetSetting"
              Content="{ll:Str 重置}"
              Command="{Binding ResetSettingCommand}"
              CommandParameter="{Binding CurrentSetting}"
            />
            <Button
              Margin="2"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              x:Name="SaveAllSetting"
              Content="{ll:Str 全部保存}"
              Command="{Binding SaveAllSettingCommand}"
            />
            <Button
              Margin="2"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              x:Name="ResetAllSetting"
              Content="{ll:Str 全部重置}"
              Command="{Binding ResetAllSettingCommand}"
            />
          </UniformGrid>
        </Grid>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid>
          <StackPanel
            IsVisible="{Binding CurrentSetting, Converter={StaticResource NullToTrueConverter}}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="8"
            Margin="24"
          >
            <ui:FASymbolIcon
              Symbol="Setting"
              FontSize="36"
              HorizontalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            />
            <TextBlock
              Classes="CaptionText"
              TextAlignment="Center"
              Text="{ll:Str '没有设置或未选择设置'}"
            />
          </StackPanel>

          <ui:FANavigationView
            x:Name="SubNavView"
            IsVisible="{Binding CurrentSetting, Converter={StaticResource NullToFalseConverter}}"
            PaneDisplayMode="Top"
            IsSettingsVisible="False"
            IsBackButtonVisible="False"
            SelectionChanged="SubNavView_SelectionChanged"
          >
            <ui:FANavigationView.MenuItems>
              <ui:FANavigationViewItem Content="{ll:Str 图像}" Tag="Graphics" IsSelected="True">
                <ui:FANavigationViewItem.IconSource>
                  <ui:FASymbolIconSource Symbol="Pictures" />
                </ui:FANavigationViewItem.IconSource>
              </ui:FANavigationViewItem>
              <ui:FANavigationViewItem Content="{ll:Str 系统}" Tag="System">
                <ui:FANavigationViewItem.IconSource>
                  <ui:FASymbolIconSource Symbol="Setting" />
                </ui:FANavigationViewItem.IconSource>
              </ui:FANavigationViewItem>
              <ui:FANavigationViewItem Content="{ll:Str 诊断}" Tag="Diagnostic">
                <ui:FANavigationViewItem.IconSource>
                  <ui:FASymbolIconSource Symbol="Repair" />
                </ui:FANavigationViewItem.IconSource>
              </ui:FANavigationViewItem>
              <ui:FANavigationViewItem Content="{ll:Str 互动}" Tag="Interactive">
                <ui:FANavigationViewItem.IconSource>
                  <ui:FASymbolIconSource Symbol="People" />
                </ui:FANavigationViewItem.IconSource>
              </ui:FANavigationViewItem>
              <ui:FANavigationViewItem Content="{ll:Str 定制}" Tag="Customized">
                <ui:FANavigationViewItem.IconSource>
                  <ui:FASymbolIconSource Symbol="Link" />
                </ui:FANavigationViewItem.IconSource>
              </ui:FANavigationViewItem>
              <ui:FANavigationViewItem Content="{ll:Str 模组}" Tag="Mod">
                <ui:FANavigationViewItem.IconSource>
                  <ui:FASymbolIconSource Symbol="AllApps" />
                </ui:FANavigationViewItem.IconSource>
              </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>

            <Grid>
              <v:GraphicsSettingView
                x:Name="GraphicsView"
                DataContext="{Binding SubSettingViewModels[Graphics]}"
              />
              <v:SystemSettingView
                x:Name="SystemView"
                IsVisible="False"
                DataContext="{Binding SubSettingViewModels[System]}"
              />
              <v:DiagnosticSettingView
                x:Name="DiagnosticView"
                IsVisible="False"
                DataContext="{Binding SubSettingViewModels[Diagnostic]}"
              />
              <v:InteractiveSettingView
                x:Name="InteractiveView"
                IsVisible="False"
                DataContext="{Binding SubSettingViewModels[Interactive]}"
              />
              <v:CustomizedSettingView
                x:Name="CustomizedView"
                IsVisible="False"
                DataContext="{Binding SubSettingViewModels[Customized]}"
              />
              <v:ModSettingView
                x:Name="ModView"
                IsVisible="False"
                DataContext="{Binding SubSettingViewModels[Mod]}"
              />
            </Grid>
          </ui:FANavigationView>
        </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</UserControl>
