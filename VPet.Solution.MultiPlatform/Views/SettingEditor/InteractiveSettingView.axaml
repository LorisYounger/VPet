<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="using:VPet_Simulator.Core"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:m="using:VPet.Solution.MultiPlatform.Models"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels"
  x:Class="VPet.Solution.MultiPlatform.Views.InteractiveSettingView"
  x:DataType="vm:InteractiveSettingViewModel"
  d:DesignHeight="800"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" Margin="10" Spacing="5">
      <!-- 桌宠设置 -->
      <ui:FASettingsExpander Header="{ll:Str '桌宠设置'}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="People" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 启用数据计算}"
          Description="{ll:Str '启用数据计算,桌宠会有状态变化,需要按时投喂等.&#10;如果嫌麻烦可以关掉'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="EnableFunction"
              IsChecked="{Binding InteractiveSetting.EnableFunction}"
              Classes="SwitchOnly"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '固定桌宠状态'}"
          Description="{ll:Str '关闭数据计算时桌宠显示的状态'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox
              x:Name="CalFunStates"
              Classes="SettingControl"
              ItemsSource="{x:Static m:InteractiveSettingModel.CalFunStates}"
              SelectedItem="{Binding InteractiveSetting.CalFunState}"
              IsEnabled="{Binding #EnableFunction.IsChecked, Converter={StaticResource BoolInverter}}"
            >
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:IGameSave+ModeType">
                  <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str '长按间隔(毫秒)'}">
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="PressLength"
              Classes="SettingControl"
              Increment="1"
              Maximum="5000"
              Minimum="50"
              Value="{Binding InteractiveSetting.PressLength, Converter={StaticResource IntToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '计算间隔(秒)'}"
          Description="{ll:Str '数据计算和互动计算时间间隔,间隔越短需要互动的频率可能会增加.&#10;间隔越大越不容易打扰到当前工作'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="LogicInterval"
              Classes="SettingControl"
              Increment="0.5"
              Minimum="5"
              Maximum="2147483647"
              Value="{Binding InteractiveSetting.LogicInterval, Converter={StaticResource DoubleToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem ToolTip.Tip="{ll:Str '互动周期决定在交互结束后大约经历多少计算间隔后再次进行自主行动'}">
          <StackPanel Spacing="2">
            <TextBlock Text="{ll:Str '互动周期(秒)'}" Classes="SettingName" />
            <TextBlock Classes="CaptionText">
              <Run Text="{ll:Str 每分钟计算}" />
              <Run x:Name="rTimeMinute" Text="4" />
              <Run Text="{ll:Str 次数值变化}" />
              <Run Text="{ll:Str 大约}" />
              <Run x:Name="RInter" Text="4" />
              <Run Text="{ll:Str '分钟左右主动进行一次互动 (走路发呆爬墙等) '}" />
            </TextBlock>
          </StackPanel>
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="InteractionCycle"
              Classes="SettingControl"
              Increment="1"
              Maximum="1000"
              Minimum="30"
              Value="{Binding InteractiveSetting.InteractionCycle, Converter={StaticResource IntToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 启用桌宠移动}"
          Description="{ll:Str '启用移动互动,桌宠会在屏幕上乱动,移动互动概率为普通互动的一半.&#10;如果嫌麻烦可以关掉'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="AllowMove"
              IsChecked="{Binding InteractiveSetting.AllowMove}"
              Classes="SwitchOnly"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 自动切换窗口}"
          Description="{ll:Str '启动窗口切换，桌宠将能自动切换窗口'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="AutoChangeWindow"
              IsChecked="{Binding InteractiveSetting.AutoChangeWindow}"
              Classes="SwitchOnly"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 启用桌宠智能移动}"
          Description="{ll:Str '当玩家在指定时间未对桌宠进行交互的时候,智能禁用移动功能&#10;将在下次交互时解除'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="SmartMove"
              IsChecked="{Binding InteractiveSetting.SmartMove}"
              IsEnabled="{Binding #AllowMove.IsChecked}"
              Classes="SwitchOnly"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 智能移动时间间隔}"
          Description="{ll:Str 智能移动判断时间间隔}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox
              x:Name="SmartMoveIntervals"
              Classes="SettingControl"
              ItemsSource="{x:Static m:InteractiveSettingModel.SmartMoveIntervals}"
              SelectedItem="{Binding InteractiveSetting.SmartMoveInterval}"
              IsEnabled="{Binding #SmartMove.IsChecked}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>

      <!-- 音乐识别设置 -->
      <ui:FASettingsExpander Header="{ll:Str '音乐识别设置'}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Audio" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 触发音量}"
          Description="{ll:Str 当实时播放音量达到该值时运行音乐动作}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="MusicCatch"
              Classes="SettingControl"
              Increment="1"
              Maximum="100"
              Minimum="0"
              Value="{Binding InteractiveSetting.MusicCatch, Converter={StaticResource IntToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 高潮音量}"
          Description="{ll:Str 当实时播放音量达到该值时运行特殊音乐动作}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="MusicMax"
              Classes="SettingControl"
              Increment="1"
              Minimum="0"
              Maximum="100"
              Value="{Binding InteractiveSetting.MusicMax, Converter={StaticResource IntToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
