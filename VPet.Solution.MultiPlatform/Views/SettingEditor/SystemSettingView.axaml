<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:m="using:VPet.Solution.MultiPlatform.Models"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels"
  x:Class="VPet.Solution.MultiPlatform.Views.SystemSettingView"
  x:DataType="vm:SystemSettingViewModel"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" Margin="10" Spacing="5">
      <!-- 保存设置 -->
      <ui:FASettingsExpander Header="{ll:Str 保存设置}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Save" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '自动保存频率(分钟)'}"
          Description="{ll:Str 在指定时间后自动保存游戏数据}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox
              x:Name="AutoSaveIntervals"
              ItemsSource="{x:Static m:SystemSettingModel.AutoSaveIntervals}"
              SelectedItem="{Binding SystemSetting.AutoSaveInterval}"
              Classes="SettingControl"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 备份数量}">
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="BackupSaveMaxNum"
              Minimum="1"
              Maximum="2147483647"
              Increment="1"
              Classes="SettingControl"
              Value="{Binding SystemSetting.BackupSaveMaxNum, Converter={StaticResource IntToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '清理缓存'}"
          Description="{ll:Str '清理缓存的动画，声音文件'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <Button
              x:Name="CacheClear"
              MinWidth="120"
              Content="{ll:Str 清理}"
              Command="{Binding CacheCleanCommand}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>

      <!-- 聊天设置 -->
      <!-- TODO: SystemSettingModel 聊天设置数据暂未实现 -->
      <ui:FASettingsExpander Header="{ll:Str 聊天设置}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Message" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem Content="{ll:Str '关闭聊天框'}">
          <ui:FASettingsExpanderItem.Footer>
            <RadioButton x:Name="RBCGPTClose" GroupName="cgpttype" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '使用桌宠选项式聊天功能'}"
          Description="{ll:Str 支持MOD与创意工坊添加聊天内容}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <RadioButton x:Name="RBCGPTUseLB" GroupName="cgpttype" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str '自定义聊天接口'}">
          <ui:FASettingsExpanderItem.Footer>
            <RadioButton x:Name="RBCGPTDIY" GroupName="cgpttype" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '聊天接口'}"
          IsEnabled="{Binding #RBCGPTDIY.IsChecked}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox x:Name="cbChatAPISelect" Classes="SettingControl" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '初始化桌宠聊天程序'}"
          IsEnabled="{Binding #RBCGPTDIY.IsChecked}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <Button x:Name="BtnCGPTReSet" MinWidth="120" Content="{ll:Str 初始化桌宠聊天程序}" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
