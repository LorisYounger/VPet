<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:m="using:VPet.Solution.MultiPlatform.Models"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels"
  x:Class="VPet.Solution.MultiPlatform.Views.GraphicsSettingView"
  x:DataType="vm:GraphicsSettingViewModel"
  d:DesignHeight="1000"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" Margin="10" Spacing="5">
      <!-- 基础显示 -->
      <ui:FASettingsExpander Padding="0" Header="{ll:Str '基础显示'}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Setting" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem Content="{ll:Str 语言}">
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox
              x:Name="Languages"
              Classes="SettingControl"
              ItemsSource="{x:Static m:GraphicsSettingModel.Languages}"
              SelectedItem="{Binding GraphicsSetting.Language}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 字体}">
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox
              x:Name="Fonts"
              Classes="SettingControl"
              ItemsSource="{x:Static m:GraphicsSettingModel.Fonts}"
              SelectedItem="{Binding GraphicsSetting.Font}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 外部消息框}"
          Description="{ll:Str 将消息框置于外部}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="MessageBarOutside"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.MessageBarOutside}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 隐藏窗口}"
          Description="{ll:Str '在任务切换器中和Alt+Tab中隐藏窗口'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="HideFromTaskControl"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.HideFromTaskControl}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>

      <!-- 置于顶层 -->
      <ui:FASettingsExpander Header="{ll:Str '置于顶层'}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Pin" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '将桌宠置于顶层'}"
          Description="{ll:Str '将桌宠置于顶层'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="TopMost"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.TopMost}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '鼠标穿透'}"
          Description="{ll:Str '鼠标将会穿过桌宠到下方内容,不打扰操作&#10;该选项'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="HitThrough"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.HitThrough}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '快速切换'}"
          Description="{ll:Str '添加快速切换小标,切换顶层或穿透'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="PetHelper"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.PetHelper}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>

      <!-- 缩放 -->
      <ui:FASettingsExpander Header="{ll:Str '缩放'}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="ZoomIn" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 更高缩放}"
          Description="{ll:Str '解锁缩放限制,支持更大缩放倍率'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="IsBiggerScreen"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.IsBiggerScreen}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 缩放等级}">
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="ZoomLevel"
              Increment="0.1"
              Classes="SettingControl"
              Value="{Binding GraphicsSetting.ZoomLevel, Converter={StaticResource DoubleToDecimalConverter}}"
              Maximum="{Binding GraphicsSetting.ZoomLevelMaximum, Converter={StaticResource DoubleToDecimalConverter}}"
              Minimum="{Binding GraphicsSetting.ZoomLevelMinimum, Converter={StaticResource DoubleToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 渲染分辨率}"
          Description="{ll:Str '桌宠图形渲染的分辨率,越高图形越清晰&#10;但是高分辨率会占用更多内存&#10;重启后生效'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="Resolution"
              Increment="10"
              Classes="SettingControl"
              Value="{Binding GraphicsSetting.Resolution, Converter={StaticResource IntToDecimalConverter}}"
              Maximum="{Binding GraphicsSetting.ResolutionMaximum, Converter={StaticResource IntToDecimalConverter}}"
              Minimum="{Binding GraphicsSetting.ResolutionMinimum, Converter={StaticResource IntToDecimalConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>

      <!-- 启动 -->
      <ui:FASettingsExpander Header="{ll:Str '启动'}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Play" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem Content="{ll:Str 启动位置}">
          <ui:FASettingsExpanderItem.Footer>
            <WrapPanel Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,8,2">
                <TextBlock Text="X" VerticalAlignment="Center" />
                <NumericUpDown
                  x:Name="StartRecordPointX"
                  MinWidth="105"
                  MaxWidth="130"
                  Classes="Base"
                  Minimum="-2147483648"
                  Maximum="2147483647"
                  Value="{Binding GraphicsSetting.StartRecordPoint.X, Converter={StaticResource DoubleToDecimalConverter}}"
                />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,2">
                <TextBlock Text="Y" VerticalAlignment="Center" />
                <NumericUpDown
                  x:Name="StartRecordPointY"
                  MinWidth="105"
                  MaxWidth="130"
                  Classes="Base"
                  Minimum="-2147483648"
                  Maximum="2147483647"
                  Value="{Binding GraphicsSetting.StartRecordPoint.Y, Converter={StaticResource DoubleToDecimalConverter}}"
                />
              </StackPanel>
            </WrapPanel>
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 设为当前位置}"
          Description="{ll:Str 设为当前窗口左上角顶点坐标的位置}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <Button
              x:Name="SetCurrentPointToStartPoint"
              MinWidth="100"
              Click="SetCurrentPointToStartPoint_Click"
              Content="{ll:Str 设定}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 保存为退出位置}">
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="StartRecordLast"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.StartRecordLast}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 开机启动}"
          Description="{ll:Str '该游戏随着开机启动该程序&#10;如需卸载游戏&#10;请关闭该选项'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="StartUPBoot"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.StartUPBoot}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str 从Steam启动}"
          Description="{ll:Str '从Steam启动该游戏, 统计时长不能停'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="StartUPBootSteam"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.StartUPBootSteam}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>

      <!-- 主题与动画 -->
      <ui:FASettingsExpander Header="{ll:Str '主题与动画'}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Pictures" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem Content="{ll:Str 主题}" Description="{ll:Str '设置主题'}">
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox
              x:Name="ThemeComboBox"
              Classes="SettingControl"
              ItemsSource="{x:Static m:GraphicsSettingModel.Themes}"
              SelectedItem="{Binding GraphicsSetting.Theme}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 桌宠动画}" Description="{ll:Str '桌宠动画'}">
          <ui:FASettingsExpanderItem.Footer>
            <ComboBox
              x:Name="Pet"
              Classes="SettingControl"
              ItemsSource="{x:Static m:GraphicsSettingModel.PetGraphs}"
              SelectedItem="{Binding GraphicsSetting.PetGraph}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 透明度}" Description="{ll:Str '桌宠透明度'}">
          <ui:FASettingsExpanderItem.Footer>
            <NumericUpDown
              x:Name="OpacityInput"
              Increment="0.05"
              Classes="SettingControl"
              Value="{Binding GraphicsSetting.Opacity, Converter={StaticResource DoubleToDecimalConverter}}"
              Maximum="1"
              Minimum="0.05"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '常态透明度'}"
          Description="{ll:Str '常态透明度'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="OpacityMain"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.OpacityMain}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem
          Content="{ll:Str '鼠标穿透透明度'}"
          Description="{ll:Str '鼠标穿透透明度'}"
        >
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch
              x:Name="OpacityHitThrough"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.OpacityHitThrough}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
