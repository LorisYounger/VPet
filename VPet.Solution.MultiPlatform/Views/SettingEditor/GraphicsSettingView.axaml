<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:m="using:VPet.Solution.MultiPlatform.Models.SettingEditor"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels.SettingEditor"
  x:Class="VPet.Solution.MultiPlatform.Views.SettingEditor.GraphicsSettingView"
  x:DataType="vm:GraphicsSettingViewModel"
  d:DesignHeight="1000"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <StackPanel>
        <Border MinHeight="50" Classes="SettingItem">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="SettingName" Text="{ll:Str 语言}" />
            <ComboBox
              x:Name="Languages"
              MinWidth="200"
              Grid.Column="1"
              Classes="Base"
              ItemsSource="{x:Static m:GraphicsSettingModel.Languages}"
              SelectedItem="{Binding GraphicsSetting.Language}"
            />
          </Grid>
        </Border>
        <Border MinHeight="50" Classes="SettingItem">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{ll:Str 字体}" Classes="SettingName" />
            <ComboBox
              x:Name="Fonts"
              Grid.Column="1"
              MinWidth="200"
              Classes="Base"
              ItemsSource="{x:Static m:GraphicsSettingModel.Fonts}"
              SelectedItem="{Binding GraphicsSetting.Font}"
            />
          </Grid>
        </Border>
        <Border MinHeight="50" Classes="SettingItem">
          <Grid ToolTip.Tip="{ll:Str 将消息框置于外部}" ColumnDefinitions="*,Auto">
            <TextBlock Text="{ll:Str 外部消息框}" Classes="SettingName" />
            <ToggleSwitch
              x:Name="MessageBarOutside"
              Grid.Column="1"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.MessageBarOutside}"
            />
          </Grid>
        </Border>
        <Border MinHeight="50" Classes="SettingItem">
          <Grid
            ColumnDefinitions="*,Auto"
            ToolTip.Tip="{ll:Str '在任务切换器中和Alt+Tab中隐藏窗口'}"
          >
            <TextBlock Text="{ll:Str 隐藏窗口}" Classes="SettingName" />
            <ToggleSwitch
              x:Name="HideFromTaskControl"
              Grid.Column="1"
              Classes="SwitchOnly"
              IsChecked="{Binding GraphicsSetting.HideFromTaskControl}"
            />
          </Grid>
        </Border>
      </StackPanel>

      <Border Classes="SettingGroup">
        <StackPanel>
          <TextBlock Classes="GroupHeader" Text="{ll:Str '置于顶层'}" />
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{ll:Str '将桌宠置于顶层'}">
              <TextBlock Text="{ll:Str '将桌宠置于顶层'}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="TopMost"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.TopMost}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid
              ColumnDefinitions="*,Auto"
              ToolTip.Tip="{ll:Str '鼠标将会穿过桌宠到下方内容,不打扰操作&#10;该选项'}"
            >
              <TextBlock Text="{ll:Str '鼠标穿透'}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="HitThrough"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.HitThrough}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid
              ColumnDefinitions="*,Auto"
              ToolTip.Tip="{ll:Str '添加快速切换小标,切换顶层或穿透'}"
            >
              <TextBlock Text="{ll:Str '快速切换'}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="PetHelper"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.PetHelper}"
              />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="SettingGroup">
        <StackPanel>
          <TextBlock Classes="GroupHeader" Text="{ll:Str '缩放'}" />
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{ll:Str '解锁缩放限制,支持更大缩放倍率'}">
              <TextBlock Text="{ll:Str 更高缩放}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="IsBiggerScreen"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.IsBiggerScreen}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{ll:Str 缩放等级}" Classes="SettingName" />
              <NumericUpDown
                Grid.Column="1"
                Width="140"
                x:Name="ZoomLevel"
                Increment="0.1"
                Classes="Base"
                Value="{Binding GraphicsSetting.ZoomLevel, Converter={StaticResource DoubleToDecimalConverter}}"
                Maximum="{Binding GraphicsSetting.ZoomLevelMaximum, Converter={StaticResource DoubleToDecimalConverter}}"
                Minimum="{Binding GraphicsSetting.ZoomLevelMinimum, Converter={StaticResource DoubleToDecimalConverter}}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid
              ColumnDefinitions="*,Auto"
              ToolTip.Tip="{ll:Str '桌宠图形渲染的分辨率,越高图形越清晰&#10;但是高分辨率会占用更多内存&#10;重启后生效'}"
            >
              <TextBlock Text="{ll:Str 渲染分辨率}" Classes="SettingName" />
              <NumericUpDown
                Grid.Column="1"
                Increment="10"
                Width="140"
                x:Name="Resolution"
                Classes="Base"
                Value="{Binding GraphicsSetting.Resolution, Converter={StaticResource IntToDecimalConverter}}"
                Maximum="{Binding GraphicsSetting.ResolutionMaximum, Converter={StaticResource IntToDecimalConverter}}"
                Minimum="{Binding GraphicsSetting.ResolutionMinimum, Converter={StaticResource IntToDecimalConverter}}"
              />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="SettingGroup">
        <StackPanel>
          <TextBlock Classes="GroupHeader" Text="{ll:Str '启动'}" />
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{ll:Str 启动位置}" Classes="SettingName" />
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" Grid.Column="1">
                <Label Grid.Column="0" Content="X" Classes="Base" />
                <NumericUpDown
                  Grid.Column="1"
                  Width="130"
                  x:Name="StartRecordPointX"
                  Classes="Base"
                  Minimum="-2147483648"
                  Maximum="2147483647"
                  Value="{Binding GraphicsSetting.StartRecordPoint.X, Converter={StaticResource DoubleToDecimalConverter}}"
                />
                <Label Grid.Column="2" Content="Y" Classes="Base" />
                <NumericUpDown
                  Grid.Column="3"
                  x:Name="StartRecordPointY"
                  Width="130"
                  Classes="Base"
                  Minimum="-2147483648"
                  Maximum="2147483647"
                  Value="{Binding GraphicsSetting.StartRecordPoint.Y, Converter={StaticResource DoubleToDecimalConverter}}"
                />
              </Grid>
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid
              ColumnDefinitions="*,Auto"
              ToolTip.Tip="{ll:Str 设为当前窗口左上角顶点坐标的位置}"
            >
              <TextBlock Text="{ll:Str 设为当前位置}" Classes="SettingName" />
              <Button
                x:Name="SetCurrentPointToStartPoint"
                Grid.Column="1"
                MinWidth="100"
                Click="SetCurrentPointToStartPoint_Click"
                Content="{ll:Str 设定}"
                Classes="Base"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{ll:Str 保存为退出位置}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="StartRecordLast"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.StartRecordLast}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid
              ColumnDefinitions="*,Auto"
              ToolTip.Tip="{ll:Str '该游戏随着开机启动该程序&#10;如需卸载游戏&#10;请关闭该选项'}"
            >
              <TextBlock Text="{ll:Str 开机启动}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="StartUPBoot"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.StartUPBoot}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid
              ColumnDefinitions="*,Auto"
              ToolTip.Tip="{ll:Str '从Steam启动该游戏, 统计时长不能停'}"
            >
              <TextBlock Text="{ll:Str 从Steam启动}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="StartUPBootSteam"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.StartUPBootSteam}"
              />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="SettingGroup">
        <StackPanel>
          <TextBlock Classes="GroupHeader" Text="{ll:Str '主题与动画'}" />
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{ll:Str '设置主题'}">
              <TextBlock Text="{ll:Str 主题}" Classes="SettingName" />
              <ComboBox
                x:Name="ThemeComboBox"
                Grid.Column="1"
                MinWidth="200"
                Classes="Base"
                ItemsSource="{x:Static m:GraphicsSettingModel.Themes}"
                SelectedItem="{Binding GraphicsSetting.Theme}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{ll:Str '桌宠动画'}">
              <TextBlock Text="{ll:Str 桌宠动画}" Classes="SettingName" />
              <ComboBox
                x:Name="Pet"
                Grid.Column="1"
                MinWidth="200"
                Classes="Base"
                ItemsSource="{x:Static m:GraphicsSettingModel.PetGraphs}"
                SelectedItem="{Binding GraphicsSetting.PetGraph}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{ll:Str '桌宠透明度'}">
              <TextBlock Text="{ll:Str 透明度}" Classes="SettingName" />
              <NumericUpDown
                Grid.Column="1"
                Increment="0.05"
                Width="140"
                x:Name="OpacityInput"
                Classes="Base"
                Value="{Binding GraphicsSetting.Opacity, Converter={StaticResource DoubleToDecimalConverter}}"
                Maximum="1"
                Minimum="0.05"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{ll:Str '常态透明度'}">
              <TextBlock Text="{ll:Str '常态透明度'}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="OpacityMain"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.OpacityMain}"
              />
            </Grid>
          </Border>
          <Border MinHeight="50" Classes="SettingGroupItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{ll:Str '鼠标穿透透明度'}">
              <TextBlock Text="{ll:Str '鼠标穿透透明度'}" Classes="SettingName" />
              <ToggleSwitch
                x:Name="OpacityHitThrough"
                Grid.Column="1"
                Classes="SwitchOnly"
                IsChecked="{Binding GraphicsSetting.OpacityHitThrough}"
              />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
