<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels"
  x:Class="VPet.Solution.MultiPlatform.Views.SaveDataView"
  x:DataType="vm:SaveViewModel"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" Margin="10" Spacing="5">
      <ui:FASettingsExpander Header="{ll:Str 数据}" IsExpanded="True">
        <ui:FASettingsExpander.IconSource>
          <ui:FASymbolIconSource Symbol="Document" />
        </ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem Content="{ll:Str 保存日期}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.DateSaved, StringFormat='yyyy/MM/dd HH:mm:ss'}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 宠物名称}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.PetName}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 模式}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.Mode, Converter={StaticResource TranslateConverter}}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 等级}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.Level}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 金钱}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.Money, StringFormat=F2}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 经验}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.Exp, StringFormat=F2}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 体力}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.Strength, StringFormat=F2}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 心情}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.Feeling, StringFormat=F2}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 饱腹度}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.StrengthFood, StringFormat=F2}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="{ll:Str 口渴度}">
          <ui:FASettingsExpanderItem.Footer>
            <TextBlock
              FontWeight="SemiBold"
              VerticalAlignment="Center"
              Text="{Binding CurrentSave.StrengthDrink, StringFormat=F2}"
            />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
