<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:VPet.Solution.MultiPlatform"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ll="using:VPet_Simulator.Core.MutiPlatform.Localization"
  xmlns:v="using:VPet.Solution.MultiPlatform.Views"
  xmlns:vm="using:VPet.Solution.MultiPlatform.ViewModels"
  x:Class="VPet.Solution.MultiPlatform.Views.SaveWindow"
  x:DataType="vm:SaveViewModel"
  Title="{ll:Str 'VPET 存档查看器'}"
  Icon="/Assets/icon.ico"
  Width="1020"
  Height="660"
  MinWidth="320"
  MinHeight="450"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <v:SaveView />
</Window>
