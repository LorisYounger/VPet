<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="https://hkw.com/commonvalueconverters/avalonia"
  xmlns:local="using:VPet.Solution.MultiPlatform"
>
  <c:MarginMultiConverter x:Key="MarginMultiConverter" />
  <c:MarginMultiConverter x:Key="RatioMarginMultiConverter" HasRatio="True" />
  <c:CalculatorConverter x:Key="CalculatorConverter" />
  <c:StringFormatMultiConverter x:Key="StringFormatMultiConverter" />
  <c:EqualsConverter x:Key="EqualsConverter" />
  <c:EqualsConverter x:Key="NotEqualsConverter" IsInverted="True" />
  <c:NumberCompareByConverter x:Key="Int32CompareByConverter" />
  <c:NullToTrueConverter x:Key="NullToFalseConverter" IsInverted="True" />
  <c:NullToTrueConverter x:Key="NullToTrueConverter" />
  <c:BoolInverterConverter x:Key="BoolInverter" />
  <local:LPSTranslateConverter x:Key="TranslateConverter" />
  <local:DoubleToDecimalConverter x:Key="DoubleToDecimalConverter" />
  <local:IntToDecimalConverter x:Key="IntToDecimalConverter" />
  <c:StringCheckConverter
    x:Key="StringIsNotNullOrWhiteSpace"
    IsInverted="True"
    StringCheckType="NullOrWhiteSpace"
  />
  <c:StringCheckConverter x:Key="StringIsNullOrWhiteSpace" StringCheckType="NullOrWhiteSpace" />
  <c:CollectionCountCompareConverter x:Key="CollectionCountCompareConverter" />
</ResourceDictionary>
