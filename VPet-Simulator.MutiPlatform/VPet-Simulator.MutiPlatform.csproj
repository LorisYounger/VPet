<Project Sdk="Microsoft.NET.Sdk">

	<!--
	跨平台桌宠宿主 (Avalonia).

	对应 Windows 版的 VPet-Simulator.Windows, 目录与文件切法照搬那边:
	  MainWindow.axaml(.cs) / MainWindow.cs / MainWindow_Function.cs / MainWindow_Property.cs  宿主主窗口
	  Function\   Setting / CoreMOD / MWController / UnifiedPluginHost / SteamCapability / SteamMultiplayer / Win32
	  WinDesign\  各 winXxx 窗口, 同名 XAML + code-behind 逐文件移植
	  MutiPlayer\ 访客表 (winMutiPlayer / MPFriends / MPUserControl / winMPBetterBuy / MPController / MPMOD), 联机走真实 Steam
	  Design\     AutoUniformGrid 与转换器
	  DevTools\   界面走查开关 (启动参数 ui-walk, 与 Windows 的 Set.DeBug / winConsole 同性质)

	Windows 版靠 Panuon.WPF.UI 的地方, 这里由 Core.MutiPlatform\Display 下的样式表提供同 Key 的预设样式,
	XAML 里的 pu: 用法按固定映射表机械替换; 每处平台差异都在原位留中文注释.
	老式 WPF MOD (MainPlugin) 不在这里跑, 跨平台 MOD 走统一契约 VPet-Simulator.Unified.Interface.
	-->

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VPet_Simulator.MutiPlatform</RootNamespace>
		<AssemblyName>VPet-Simulator.MutiPlatform</AssemblyName>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- 桌宠窗口自己画, 不需要 Avalonia 的默认标题栏 -->
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<!-- Steam 原生绑定随发布目标选择; 未指定 RID 时按当前系统构建, Windows 只支持 x64. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
		<PlatformTarget Condition="'$(RuntimeIdentifier)' != 'osx-arm64'">x64</PlatformTarget>
		<PlatformTarget Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">ARM64</PlatformTarget>
		<SteamworksBinding Condition="'$(RuntimeIdentifier)' == 'win-x64'">Win64</SteamworksBinding>
		<SteamworksBinding Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'">Posix</SteamworksBinding>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="mklink.bat" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Simple" Version="12.1.1" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
	</ItemGroup>

	<!-- 官方 Facepunch.Steamworks 2.5.2 的 net6.0 程序集也可由 net8.0 宿主引用. -->
	<ItemGroup>
		<Reference Include="Facepunch.Steamworks.$(SteamworksBinding)" Condition="'$(SteamworksBinding)' != ''">
			<HintPath>Lib/Steamworks/2.5.2/net6.0/Facepunch.Steamworks.$(SteamworksBinding).dll</HintPath>
			<Private>true</Private>
		</Reference>
		<None Update="Lib/Steamworks/2.5.2/runtimes/win-x64/steam_api64.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Lib/Steamworks/2.5.2/runtimes/linux-x64/libsteam_api.so" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" Link="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Lib/Steamworks/2.5.2/runtimes/osx/libsteam_api.dylib" Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'" Link="libsteam_api.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="ValidateSteamworksPlatform" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(SteamworksBinding)' == '' or '$(Platform)' == 'x86' or '$(PlatformTarget)' == 'x86'" Text="Steamworks 仅支持 win-x64、linux-x64、osx-x64 和 osx-arm64; 不再支持 Windows 32 位. 请使用 -r 指定支持的目标平台." />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\VPet_Simulator.Core.MutiPlatform\VPet_Simulator.Core.MutiPlatform.csproj" />
		<ProjectReference Include="..\VPet-Simulator.Windows.Interface.Base\VPet-Simulator.Windows.Interface.Base.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="vpeticon.ico" />
		<AvaloniaResource Include="Res/remixicon.ttf" />
		<AvaloniaResource Include="Res/**/*.png" />
	</ItemGroup>

</Project>
