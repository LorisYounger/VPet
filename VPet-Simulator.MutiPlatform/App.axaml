<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VPet_Simulator.MutiPlatform.App"
             Name="VPet"
             RequestedThemeVariant="Light">
    <!-- Name 是 macOS 菜单栏左上角显示的应用名 (不设就是 "Avalonia Application"); 打成 .app 包之后以 Info.plist 的 CFBundleName 为准 -->
    <!--
    颜色全由 Theme.axaml 定, 与 Windows 版一样不跟系统深浅色走, 所以钉死 Light
    (不钉的话原生控件 (NumericUpDown/滚动条…) 会在深色系统上变黑).
    对应 Windows 版 VPet-Simulator.Windows/App.xaml: 全局字体、图标字体, 再合并
    Windows.Interface 的 ResourceStyle (那边由 Panuon 的 GlobalSettings 定全局字号 14).
    -->
    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
        <!-- 全局默认: 字号 14、正文黑字, 对应 pu:GlobalSettings FontSize=14 -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        </Style>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource MainFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- Label 的字符串内容默认走 AccessText, 多行文案会叠在一起画; WPF 那边没这问题, 这里换成普通 TextBlock 来显示 -->
        <Style Selector="Label">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter>
        </Style>
        <!--
        SimpleTheme 的默认观感与 Windows 版差得远的几处, 全局拉回来 (Panuon 那边这些都是库的默认样式):
        输入框深色底浅色字、勾选框旁的字太浅、进度条配色
        -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Secondary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource DARKPrimary}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource DARKPrimary}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryTrans4}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinHeight" Value="6" />
        </Style>
        <!-- pu:Spin 的对应物: 一段转圈的弧 -->
        <Style Selector="Arc.Spin">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!--
                    字体: 启动时 FontLoader 会按设置里的 font 键换掉 MainFont.
                    默认留空表示系统默认字体 —— 三个平台各自的默认中文字体都是合适的.
                    (Windows 版内嵌 OPPOSans R; 跨平台版 MOD 自带的 ttf 装不上, 见 FontLoader)
                    -->
                    <FontFamily x:Key="MainFont">$Default</FontFamily>
                    <FontFamily x:Key="VPetFont">$Default</FontFamily>
                    <FontFamily x:Key="RemixIcon">avares://VPet-Simulator.MutiPlatform/Res/remixicon.ttf#remixicon</FontFamily>
                </ResourceDictionary>
                <ResourceInclude Source="avares://VPet_Simulator.Core.MutiPlatform/Display/ResourceStyle.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
