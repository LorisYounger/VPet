<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VPet_Simulator.MutiPlatform.PetWindow"
        Title="VPet"
        Width="250" Height="250"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        SizeToContent="Manual">
    <!--
    桌宠窗口: 无边框、透明背景、置顶、不进任务栏.
    与 Windows 版 MainWindow.xaml 的意图一致, 只是 WPF 那边需要靠 WindowChrome
    加强制 WS_EX_LAYERED 的 Win32 hook 才能做到, Avalonia 这里是声明式的.
    -->
    <Grid x:Name="RootGrid">
        <ContentControl x:Name="PetHost" />
        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource DARKPrimaryText}"
                   Background="{DynamicResource DARKPrimaryTransA}"
                   Padding="12,6" TextWrapping="Wrap" MaxWidth="230"
                   IsVisible="False" />
    </Grid>
</Window>
